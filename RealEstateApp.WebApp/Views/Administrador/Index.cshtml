@model AdministradorHomeViewModel
@{
    ViewData["Title"] = "Home del administrador";
}

<div class="page-header">
    <div>
        <h1>Panel del administrador</h1>
        <p class="page-header-subtitle">Indicadores generales del sistema.</p>
    </div>
</div>

<div class="row row-cols-2 row-cols-lg-4 g-3">
    <div class="col">
        <div class="card stat-card">
            <div class="stat-value">@Model.PropiedadesDisponibles</div>
            <div class="stat-label">Propiedades disponibles</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-neutral">
            <div class="stat-value">@Model.PropiedadesVendidas</div>
            <div class="stat-label">Propiedades vendidas</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-success">
            <div class="stat-value">@Model.AgentesActivos</div>
            <div class="stat-label">Agentes activos</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-danger">
            <div class="stat-value">@Model.AgentesInactivos</div>
            <div class="stat-label">Agentes inactivos</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-success">
            <div class="stat-value">@Model.ClientesActivos</div>
            <div class="stat-label">Clientes activos</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-danger">
            <div class="stat-value">@Model.ClientesInactivos</div>
            <div class="stat-label">Clientes inactivos</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-success">
            <div class="stat-value">@Model.DesarrolladoresActivos</div>
            <div class="stat-label">Desarrolladores activos</div>
        </div>
    </div>
    <div class="col">
        <div class="card stat-card stat-danger">
            <div class="stat-value">@Model.DesarrolladoresInactivos</div>
            <div class="stat-label">Desarrolladores inactivos</div>
        </div>
    </div>
</div>
