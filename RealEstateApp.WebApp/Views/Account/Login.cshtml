@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h1 class="mb-2">Iniciar sesión</h1>
            <p class="text-muted">Accede a tu cuenta de RealEstateApp.</p>
        </div>

        @if (ViewData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-info">@mensaje</div>
        }

        <div class="auth-card">
            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UsuarioOCorreo" class="form-label"></label>
                    <input asp-for="UsuarioOCorreo" class="form-control" />
                </div>
                <div class="mb-4">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" />
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary">Iniciar sesión</button>
                </div>
                <div class="d-flex flex-column flex-sm-row justify-content-between text-center gap-2">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-link p-0">¿No tienes cuenta? Únete a la app</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link p-0">Volver al inicio</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
