@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1 class="mb-4">Iniciar sesión</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UsuarioOCorreo" class="form-label"></label>
                <input asp-for="UsuarioOCorreo" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Iniciar sesión</button>
            <a asp-controller="Account" asp-action="Register" class="btn btn-link">¿No tienes cuenta? Únete a la app</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-link">Volver al inicio</a>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
