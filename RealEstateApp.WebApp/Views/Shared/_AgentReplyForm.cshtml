@model AgentReplyViewModel

<form asp-controller="Agente" asp-action="Responder" method="post">
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="ClienteId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2">
        <textarea asp-for="Texto" class="form-control" rows="2" placeholder="Escribe tu respuesta..."></textarea>
        <span asp-validation-for="Texto" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Enviar respuesta</button>
</form>
