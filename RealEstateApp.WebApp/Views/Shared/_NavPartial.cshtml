@{
    var esCliente = User.IsInRole("Cliente");
    var esAgente = User.IsInRole("Agente");
    var esAdministrador = User.IsInRole("Administrador");
}
<ul class="navbar-nav flex-grow-1">
    @if (!User.Identity!.IsAuthenticated)
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Agentes" asp-action="Index">Agentes</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Únete a la app</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
    }
    else if (esCliente)
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Agentes" asp-action="Index">Agentes</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Cliente" asp-action="MisPropiedades">Mis propiedades</a></li>
    }
    else if (esAgente)
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Agente" asp-action="Index">Home del agente</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="MantenimientoPropiedades" asp-action="Index">Mantenimiento de propiedades</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Agente" asp-action="Perfil">Mi perfil</a></li>
    }
    else if (esAdministrador)
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Administrador" asp-action="Index">Home del administrador</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Administrador" asp-action="Agentes">Listado de los agentes</a></li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" id="menuMantenimientos" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Mantenimientos
            </a>
            <ul class="dropdown-menu" aria-labelledby="menuMantenimientos">
                <li><a class="dropdown-item" asp-controller="MantenimientoAdministradores" asp-action="Index">Administradores</a></li>
                <li><a class="dropdown-item" asp-controller="MantenimientoDesarrolladores" asp-action="Index">Desarrolladores</a></li>
                <li><a class="dropdown-item" asp-controller="MantenimientoTipoPropiedades" asp-action="Index">Tipo de propiedades</a></li>
                <li><a class="dropdown-item" asp-controller="MantenimientoTipoVentas" asp-action="Index">Tipo de ventas</a></li>
                <li><a class="dropdown-item" asp-controller="MantenimientoMejoras" asp-action="Index">Mejoras</a></li>
            </ul>
        </li>
    }
</ul>
@if (User.Identity!.IsAuthenticated)
{
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
        <button type="submit" class="nav-link text-dark btn btn-link">Cerrar sesión</button>
    </form>
}
