@model PropertyBrowseViewModel
@{
    var contextoCliente = ViewData["ContextoCliente"] as bool? == true;
}

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

@if (Model.Propiedades.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var propiedad in Model.Propiedades)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                    {
                        <img src="@propiedad.ImagenPrincipal" class="card-img-top" alt="@propiedad.TipoPropiedad" style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-muted">Sin imagen</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@propiedad.TipoPropiedad &middot; @propiedad.TipoVenta</h5>
                        <p class="card-text">
                            Código: @propiedad.Codigo<br />
                            Precio: RD$@propiedad.Precio.ToString("N0")<br />
                            @propiedad.CantidadHabitaciones hab. / @propiedad.CantidadBanos baños<br />
                            Terreno: @propiedad.TamanoTerreno.ToString("N0") m&sup2;
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        @if (contextoCliente)
                        {
                            <form asp-controller="Cliente" asp-action="ToggleFavorito" method="post" class="mb-2">
                                <input type="hidden" name="propertyId" value="@propiedad.Id" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-sm w-100 @(propiedad.EsFavorito ? "btn-danger" : "btn-outline-danger")">
                                    @(propiedad.EsFavorito ? "Quitar de favoritos" : "Agregar a favoritos")
                                </button>
                            </form>
                        }
                        <a asp-controller="@(contextoCliente ? "Cliente" : "Home")" asp-action="@(contextoCliente ? "Detalle" : "Details")" asp-route-id="@propiedad.Id" class="btn btn-outline-primary w-100">Ver detalle</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
