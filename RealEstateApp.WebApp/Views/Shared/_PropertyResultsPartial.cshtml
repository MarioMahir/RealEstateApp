@model PropertyBrowseViewModel
@{
    var contextoCliente = ViewData["ContextoCliente"] as bool? == true;
}

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

@if (Model.Propiedades.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var propiedad in Model.Propiedades)
        {
            <div class="col">
                <div class="card h-100 card-hover">
                    @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                    {
                        <img src="@propiedad.ImagenPrincipal" class="card-img-top" alt="@propiedad.TipoPropiedad" style="height:190px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:190px;background-color:var(--bg-alt);">
                            <span class="text-muted small">Sin imagen</span>
                        </div>
                    }
                    <div class="card-body pb-2">
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-primary">@propiedad.TipoPropiedad</span>
                            <span class="badge bg-secondary">@propiedad.TipoVenta</span>
                        </div>
                        <p class="price-tag mb-1">RD$@propiedad.Precio.ToString("N0")</p>
                        <p class="text-muted small mb-2">Código @propiedad.Codigo</p>
                        <p class="text-muted small mb-0">
                            @propiedad.CantidadHabitaciones hab &middot; @propiedad.CantidadBanos baños &middot; @propiedad.TamanoTerreno.ToString("N0") m&sup2;
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-grid gap-2">
                        @if (contextoCliente)
                        {
                            <form asp-controller="Cliente" asp-action="ToggleFavorito" method="post">
                                <input type="hidden" name="propertyId" value="@propiedad.Id" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-sm w-100 @(propiedad.EsFavorito ? "btn-danger" : "btn-outline-danger")">
                                    @(propiedad.EsFavorito ? "Quitar de favoritos" : "Agregar a favoritos")
                                </button>
                            </form>
                        }
                        <a asp-controller="@(contextoCliente ? "Cliente" : "Home")" asp-action="@(contextoCliente ? "Detalle" : "Details")" asp-route-id="@propiedad.Id" class="btn btn-outline-primary w-100">Ver detalle</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
