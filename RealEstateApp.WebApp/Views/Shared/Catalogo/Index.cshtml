@model List<CatalogItemViewModel>
@{
    var titulo = ViewData["Titulo"] as string;
    ViewData["Title"] = titulo;
}

<div class="page-header">
    <h1>@titulo</h1>
    <div class="page-header-actions">
        <a asp-action="Crear" class="btn btn-primary">@ViewData["TituloNuevo"]</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>@ViewData["EmptyListMessage"]</p>
    </div>
}
else
{
    <div class="table-wrap">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Cantidad de propiedades</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td class="text-muted">@item.Descripcion</td>
                            <td>@item.CantidadPropiedades</td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
