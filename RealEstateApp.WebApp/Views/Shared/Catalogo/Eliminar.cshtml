@model CatalogItemViewModel
@{
    ViewData["Title"] = ViewData["Titulo"];
}

<h1 class="mb-4">Eliminar</h1>

<div class="alert alert-warning">@ViewData["DeleteConfirmMessage"]</div>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Aceptar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
