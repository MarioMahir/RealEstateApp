@model CatalogItemViewModel
@{
    ViewData["Title"] = ViewData["Titulo"];
}

<h1 class="mb-4">Eliminar</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="auth-card">
            <div class="alert alert-warning">@ViewData["DeleteConfirmMessage"]</div>

            <dl class="row">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>
                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.Descripcion</dd>
            </dl>

            <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">Aceptar</button>
            </form>
        </div>
    </div>
</div>
