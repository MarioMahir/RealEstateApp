@model List<PropertyListItemViewModel>
@{
    ViewData["Title"] = "Mantenimiento de propiedades";
    var mensaje = ViewData["Mensaje"] as string;
}

<div class="page-header">
    <div>
        <h1>Mantenimiento de propiedades</h1>
        <p class="page-header-subtitle">Crea, edita y elimina tus propiedades disponibles.</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="MantenimientoPropiedades" asp-action="Crear" class="btn btn-primary">Crear propiedad</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="empty-state">
        <p>@mensaje</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var propiedad in Model)
        {
            <div class="col">
                <div class="card h-100 card-hover">
                    @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                    {
                        <img src="@propiedad.ImagenPrincipal" class="card-img-top" alt="@propiedad.TipoPropiedad" style="height:190px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:190px;background-color:var(--bg-alt);">
                            <span class="text-muted small">Sin imagen</span>
                        </div>
                    }
                    <div class="card-body pb-2">
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-primary">@propiedad.TipoPropiedad</span>
                            <span class="badge bg-secondary">@propiedad.TipoVenta</span>
                        </div>
                        <p class="price-tag mb-1">RD$@propiedad.Precio.ToString("N0")</p>
                        <p class="text-muted small mb-2">Código @propiedad.Codigo</p>
                        <p class="text-muted small mb-0">
                            @propiedad.CantidadHabitaciones hab &middot; @propiedad.CantidadBanos baños &middot; @propiedad.TamanoTerreno.ToString("N0") m&sup2;
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-controller="MantenimientoPropiedades" asp-action="Editar" asp-route-id="@propiedad.Id" class="btn btn-outline-primary w-50">Editar</a>
                        <a asp-controller="MantenimientoPropiedades" asp-action="Eliminar" asp-route-id="@propiedad.Id" class="btn btn-outline-danger w-50">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
