@model PropertyFormViewModel
@{
    ViewData["Title"] = "Crear propiedad";
}

<h1 class="mb-4">Crear propiedad</h1>

<form asp-controller="MantenimientoPropiedades" asp-action="Crear" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_PropertyFormFields", Model)

    <a asp-controller="MantenimientoPropiedades" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Crear propiedad</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
