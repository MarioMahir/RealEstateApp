@model PropertyListItemViewModel
@{
    ViewData["Title"] = "Eliminar propiedad";
}

<div class="page-header">
    <h1>Eliminar propiedad</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="auth-card">
            <div class="alert alert-warning">¿Está seguro que desea eliminar esta propiedad?</div>

            <dl class="row">
                <dt class="col-sm-4">Código</dt>
                <dd class="col-sm-8">@Model.Codigo</dd>
                <dt class="col-sm-4">Tipo</dt>
                <dd class="col-sm-8">@Model.TipoPropiedad &middot; @Model.TipoVenta</dd>
                <dt class="col-sm-4">Precio</dt>
                <dd class="col-sm-8">RD$@Model.Precio.ToString("N0")</dd>
            </dl>

            <form asp-controller="MantenimientoPropiedades" asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <a asp-controller="MantenimientoPropiedades" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">Aceptar</button>
            </form>
        </div>
    </div>
</div>
