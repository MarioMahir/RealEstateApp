@model PropertyListItemViewModel
@{
    ViewData["Title"] = "Eliminar propiedad";
}

<h1 class="mb-4">Eliminar propiedad</h1>

<div class="alert alert-warning">¿Está seguro que desea eliminar esta propiedad?</div>

<dl class="row">
    <dt class="col-sm-2">Código</dt>
    <dd class="col-sm-10">@Model.Codigo</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoPropiedad &middot; @Model.TipoVenta</dd>
    <dt class="col-sm-2">Precio</dt>
    <dd class="col-sm-10">RD$@Model.Precio.ToString("N0")</dd>
</dl>

<form asp-controller="MantenimientoPropiedades" asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <a asp-controller="MantenimientoPropiedades" asp-action="Index" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-danger">Aceptar</button>
</form>
