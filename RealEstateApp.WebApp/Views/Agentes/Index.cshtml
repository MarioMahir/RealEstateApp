@model List<AgentListItemViewModel>
@{
    ViewData["Title"] = "Agentes";
    var nombreBusqueda = ViewData["NombreBusqueda"] as string;
}

<div class="page-header">
    <div>
        <h1>Nuestros agentes</h1>
        <p class="page-header-subtitle">Conoce a los agentes inmobiliarios activos en la plataforma.</p>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-5 col-lg-4">
        <input type="text" name="nombre" class="form-control" placeholder="Buscar por nombre o apellido" value="@nombreBusqueda" />
    </div>
    <div class="col-6 col-md-auto">
        <button type="submit" class="btn btn-primary w-100">Buscar</button>
    </div>
    <div class="col-6 col-md-auto">
        <a asp-controller="Agentes" asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar búsqueda</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>@(string.IsNullOrEmpty(nombreBusqueda) ? "No hay agentes activos registrados en este momento." : "No se encontraron agentes activos con el nombre ingresado.")</p>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var agente in Model)
        {
            <div class="col">
                <div class="card h-100 card-hover text-center">
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(agente.FotoUrl))
                        {
                            <img src="@agente.FotoUrl" class="avatar-circle mb-3" alt="@agente.Nombre @agente.Apellido" />
                        }
                        else
                        {
                            <div class="avatar-placeholder mx-auto mb-3 fs-4">
                                @agente.Nombre.Substring(0, 1).ToUpperInvariant()
                            </div>
                        }
                        <h5 class="card-title mb-3">@agente.Nombre @agente.Apellido</h5>
                        <a asp-controller="Agentes" asp-action="Propiedades" asp-route-id="@agente.Id" class="btn btn-outline-primary btn-sm w-100">Ver propiedades</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
