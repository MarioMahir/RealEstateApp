@model AgentPropertiesViewModel
@{
    ViewData["Title"] = $"Propiedades de {Model.NombreAgente}";
}

<a asp-controller="Agentes" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">&larr; Volver a agentes</a>

<div class="d-flex align-items-center gap-3 mb-4">
    @if (!string.IsNullOrEmpty(Model.FotoAgente))
    {
        <img src="@Model.FotoAgente" class="avatar-circle" style="width:64px;height:64px;" alt="@Model.NombreAgente" />
    }
    else
    {
        <div class="avatar-placeholder" style="width:64px;height:64px;">
            @Model.NombreAgente.Substring(0, 1).ToUpperInvariant()
        </div>
    }
    <div>
        <h1 class="mb-0">@Model.NombreAgente</h1>
        <p class="text-muted mb-0">Propiedades disponibles</p>
    </div>
</div>

@await Html.PartialAsync("_PropertyFilterForm", Model.Propiedades)
@await Html.PartialAsync("_PropertyResultsPartial", Model.Propiedades)

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
