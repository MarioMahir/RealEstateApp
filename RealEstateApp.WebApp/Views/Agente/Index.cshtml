@model List<PropertyListItemViewModel>
@{
    ViewData["Title"] = "Home del agente";
    var mensaje = ViewData["Mensaje"] as string;
}

<div class="page-header">
    <div>
        <h1>Home del agente</h1>
        <p class="page-header-subtitle">Tus propiedades registradas, disponibles y vendidas.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="empty-state">
        <p>@mensaje</p>
    </div>
}

@if (Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var propiedad in Model)
        {
            <div class="col">
                <div class="card h-100 card-hover">
                    @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                    {
                        <img src="@propiedad.ImagenPrincipal" class="card-img-top" alt="@propiedad.TipoPropiedad" style="height:190px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:190px;background-color:var(--bg-alt);">
                            <span class="text-muted small">Sin imagen</span>
                        </div>
                    }
                    <div class="card-body pb-2">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="d-flex gap-1 flex-wrap">
                                <span class="badge bg-primary">@propiedad.TipoPropiedad</span>
                                <span class="badge bg-secondary">@propiedad.TipoVenta</span>
                            </div>
                            <span class="badge @(propiedad.Estado == "Disponible" ? "bg-success" : "bg-secondary")">@propiedad.Estado</span>
                        </div>
                        <p class="price-tag mb-1">RD$@propiedad.Precio.ToString("N0")</p>
                        <p class="text-muted small mb-2">Código @propiedad.Codigo</p>
                        <p class="text-muted small mb-0">
                            @propiedad.CantidadHabitaciones hab &middot; @propiedad.CantidadBanos baños &middot; @propiedad.TamanoTerreno.ToString("N0") m&sup2;
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-controller="Agente" asp-action="Detalle" asp-route-id="@propiedad.Id" class="btn btn-outline-primary w-100">Ver conversaciones y ofertas</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
